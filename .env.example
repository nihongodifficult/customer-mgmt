# ─── PostgreSQL 接続設定 ───────────────────────────────────
#
# ローカル PostgreSQL の場合:
# DATABASE_URL=postgresql://postgres:パスワード@localhost:5432/yoyaku
#
# Supabase の場合:
# DATABASE_URL=postgresql://postgres:[パスワード]@db.[プロジェクトID].supabase.co:5432/postgres
#
# ConoHa / さくら VPS 等の場合:
# DATABASE_URL=postgresql://ユーザー名:パスワード@サーバーIP:5432/yoyaku

DATABASE_URL=postgresql://postgres:password@localhost:5432/yoyaku

# ─── サーバー設定 ──────────────────────────────────────────
PORT=3636
